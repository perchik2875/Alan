# ---------------------------------------------------------------------------
# Alan v1.2 — configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
ALAN_TELEGRAM_TOKEN=

# Comma-separated Telegram user ids allowed to talk to Alan.
# Strongly recommended: without it, anyone who finds the bot can use it.
# Send /start once and read the id from the log, or ask @userinfobot.
ALAN_OWNER_IDS=

# --- Reasoning model (required) ---------------------------------------------
# provider: openai | anthropic | gemini
# "openai" also covers OpenRouter, DeepSeek, Groq, Together, vLLM, LM Studio
# and any other OpenAI-compatible /chat/completions endpoint.
ALAN_LLM_PROVIDER=openai
ALAN_LLM_MODEL=gpt-4o-mini
ALAN_LLM_API_KEY=

# Base URL for OpenAI-compatible providers. Leave empty for api.openai.com.
# Examples:
#   https://openrouter.ai/api/v1
#   https://api.deepseek.com/v1
#   http://localhost:1234/v1
ALAN_LLM_BASE_URL=

ALAN_LLM_TEMPERATURE=0.2
ALAN_LLM_MAX_TOKENS=2400
ALAN_LLM_TIMEOUT=90
ALAN_LLM_MAX_RETRIES=2

# --- Meaning-based retrieval (optional but recommended) ---------------------
# provider: none | openai | gemini
# With "none", Alan still works: exact-term search plus model-selected notes.
# Gemini: ALAN_EMBED_MODEL=gemini-embedding-001 (dimensions 128-3072; 1536 is a
# good balance between recall and storage).
ALAN_EMBED_PROVIDER=none
ALAN_EMBED_MODEL=text-embedding-3-small
ALAN_EMBED_API_KEY=
ALAN_EMBED_BASE_URL=
ALAN_EMBED_DIMENSIONS=0
# ALAN_EMBED_TIMEOUT=60

# --- Storage ----------------------------------------------------------------
ALAN_DATA_DIR=data
# ALAN_DB_PATH=data/alan.db
# The user-facing Markdown vault (Obsidian-compatible). It holds notes and the
# editable prompts in .alan/prompts/; it never holds the database, logs, or keys.
# Defaults to a sibling of the data directory: ../AlanVault.
ALAN_VAULT_DIR=AlanVault

# --- Behaviour --------------------------------------------------------------
ALAN_TIMEZONE=Europe/Moscow
ALAN_DEFAULT_LANGUAGE=en
ALAN_CLARIFY_TTL_MINUTES=45
# Working memory: how many recent turns are passed to the model.
ALAN_HISTORY_TURNS=30
ALAN_SEARCH_TOP_K=6
ALAN_ANSWER_CONTEXT_K=8
# First-run dialogue: three short questions, one at a time.
ALAN_ONBOARDING=true
# Import analysis batch size. Raw captures are always stored in batches too.
ALAN_IMPORT_BATCH_SIZE=40
# Detect hand edits to the Markdown vault, version them, and re-index.
ALAN_MARKDOWN_WATCH=true
ALAN_LOG_LEVEL=INFO

# --- Proactive assistance ---------------------------------------------------
ALAN_PROACTIVE_ENABLED=true
ALAN_PROACTIVE_POLL_MINUTES=30

# Local hours during which Alan never sends proactive messages. Wrap-around
# ranges are supported (22 to 9).
ALAN_PROACTIVE_QUIET_START=22
ALAN_PROACTIVE_QUIET_END=9

ALAN_PROACTIVE_MAX_PER_DAY=1
ALAN_PROACTIVE_MIN_HOURS=20

# What counts as forgotten.
ALAN_STALE_PROJECT_DAYS=14
ALAN_OPEN_QUESTION_DAYS=10
ALAN_CONFLICT_DAYS=2
ALAN_DUE_SOON_HOURS=48
ALAN_MIN_CANDIDATE_AGE_DAYS=2
